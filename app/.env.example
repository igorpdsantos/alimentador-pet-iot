# Copie para .env (fora do git). Ver specs/06-app-mobile.md §4.
# Atenção: variáveis VITE_* ficam embutidas no app publicado; use uma credencial só para o app,
# diferente da do ESP32. Também dá para digitar tudo isso na tela de pareamento.
VITE_MQTT_URL=wss://xxxxxxxx.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_USER=usuario-do-app
VITE_MQTT_PASS=senha-do-app
